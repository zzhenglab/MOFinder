{
  "project_root": "..",
  "positive_csv": "data/cleaned_data/archived/positive_stage6.csv",
  "negative_csv": "data/cleaned_data/archived/negative_stage6_v3.csv",
  "metadata_file": "data/metadata/publication_years.csv",
  "output_dir": "results/datasets/archived_conditions",
  "prompt_file": "prompts/training/reaction_prediction.txt",
  "forced_questions_file": "configs/dataset_forced_questions.json",
  "rng_seed": 42,
  "holdout_frac": 0.1,
  "holdout_cluster_frac": 0.1,
  "pn_mode": "equal",
  "raw_pn_relative_tolerance": 0.1,
  "cluster_metal_mode": "precursor",
  "include_modulator_in_cluster": false,
  "year_bins": 4,
  "year_bins_5": 5,
  "drop_input_label_conflicts": true,
  "dedup_exact_input_within_label": true,
  "shuffle_output": true,
  "holdout_search_trials": 64,
  "holdout_search_swaps": 1200,
  "input_provenance": {
    "positive": "Archived positive stage 6 records with four local-path columns removed.",
    "negative": "Archived negative stage 6_v3 records with four local-path columns removed."
  }
